{
  "sws2-cs2menus": {
    "Debug": false,
    "Menu": {
      // Options shown on one page. Clamped to 1-5.
      "DefaultPageSize": 5,
      "PlaySound": true,
      "ShowBack": true,
      "ShowClose": true,
      "CloseOnSelect": true,
      "DefaultComment": "",
      // auto = custom HUD when the Panorama addon is mounted, otherwise center HTML.
      // hudlayout = force custom HUD, classic = force center HTML.
      "Backend": "auto",
      "HudLayoutPath": "panorama/layout/custom_game/sws2cs2menus/menu.xml",
      "HudLayoutWorkshopId": "",
      "Colors": {
        "Title": "#FFD700",
        "Comment": "#AAAAAA",
        "Focused": "#FFD700",
        "Disabled": "#808080"
      }
    },
    "Demo": {
      "EnableCommand": true,
      "CommandPermission": ""
    }
  }
}
