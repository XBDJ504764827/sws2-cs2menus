{
  "sws2-cs2menus": {
    "Debug": false,
    "Menu": {
      // Options shown on one page. Clamped to 1-5.
      "DefaultPageSize": 5,
      "PlaySound": true,
      "ShowBack": true,
      "ShowClose": true,
      "CloseOnSelect": true,
      "DefaultComment": "",
      "Colors": {
        "Title": "#FFD700",
        "Comment": "#AAAAAA",
        "Focused": "#FFD700",
        "Disabled": "#808080"
      }
    },
    "Demo": {
      "EnableCommand": true,
      "CommandPermission": ""
    }
  }
}
