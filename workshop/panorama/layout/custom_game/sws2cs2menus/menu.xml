<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/sws2cs2menus/menu.css" />
  </styles>
  <Panel class="root" hittest="false">
    <Panel id="sw_root" hittest="false">
      <Panel class="menu-box">
        <Panel class="topbar">
          <Panel class="brand-mark" hittest="false"><Label text="S" hittest="false" /></Panel>
          <Label class="brand-name" text="SWS2" hittest="false" />
          <Panel class="topbar-divider" hittest="false" />
          <Label id="sw_brand" class="brand-caption" text="{s:sw_brand}" hittest="false" />
          <Panel class="operator" hittest="false">
            <Panel class="status-dot" />
            <Label id="sw_operator" text="{s:sw_operator}" />
          </Panel>
          <Button id="sw_close" class="close-btn"><Label text="×" hittest="false" /></Button>
        </Panel>
        <Panel class="content">
          <Panel class="breadcrumb" hittest="false">
            <Label id="sw_context" text="{s:sw_context}" />
          </Panel>
          <Panel class="heading" hittest="false">
            <Label id="sw_title" class="menu-title" text="{s:sw_title}" />
            <Label id="sw_count" class="count-badge" text="{s:sw_count}" />
          </Panel>
          <Panel id="sw_comment" class="menu-comment" hittest="false">
            <Label id="sw_comment_text" text="{s:sw_comment_text}" />
          </Panel>
          <Panel class="section-line" hittest="false">
            <Panel class="section-accent" />
            <Label id="sw_section" text="{s:sw_section}" />
            <Panel class="section-rule" />
          </Panel>
          <Panel class="menu-items" hittest="false">
          <Button id="sw_item0" class="item">
            <Panel class="item-marker" hittest="false" />
            <Panel class="item-symbol" hittest="false">
              <Panel class="symbol-icon players-icon" hittest="false" />
              <Panel class="symbol-icon maps-icon" hittest="false" />
              <Panel class="symbol-icon warning-icon" hittest="false" />
              <Label id="sw_item0_glyph" class="item-glyph" text="{s:sw_item0_glyph}" hittest="false" />
            </Panel>
            <Panel class="item-body" hittest="false">
              <Label id="sw_item0_text" class="item-text" text="{s:sw_item0_text}" hittest="false" />
              <Label id="sw_item0_comment" class="item-comment" text="{s:sw_item0_comment}" hittest="false" />
            </Panel>
            <Label id="sw_item0_action" class="item-action" text="{s:sw_item0_action}" hittest="false" />
            <Label class="item-arrow" text="›" hittest="false" />
          </Button>
          <Button id="sw_item1" class="item">
            <Panel class="item-marker" hittest="false" />
            <Panel class="item-symbol" hittest="false">
              <Panel class="symbol-icon players-icon" hittest="false" />
              <Panel class="symbol-icon maps-icon" hittest="false" />
              <Panel class="symbol-icon warning-icon" hittest="false" />
              <Label id="sw_item1_glyph" class="item-glyph" text="{s:sw_item1_glyph}" hittest="false" />
            </Panel>
            <Panel class="item-body" hittest="false">
              <Label id="sw_item1_text" class="item-text" text="{s:sw_item1_text}" hittest="false" />
              <Label id="sw_item1_comment" class="item-comment" text="{s:sw_item1_comment}" hittest="false" />
            </Panel>
            <Label id="sw_item1_action" class="item-action" text="{s:sw_item1_action}" hittest="false" />
            <Label class="item-arrow" text="›" hittest="false" />
          </Button>
          <Button id="sw_item2" class="item">
            <Panel class="item-marker" hittest="false" />
            <Panel class="item-symbol" hittest="false">
              <Panel class="symbol-icon players-icon" hittest="false" />
              <Panel class="symbol-icon maps-icon" hittest="false" />
              <Panel class="symbol-icon warning-icon" hittest="false" />
              <Label id="sw_item2_glyph" class="item-glyph" text="{s:sw_item2_glyph}" hittest="false" />
            </Panel>
            <Panel class="item-body" hittest="false">
              <Label id="sw_item2_text" class="item-text" text="{s:sw_item2_text}" hittest="false" />
              <Label id="sw_item2_comment" class="item-comment" text="{s:sw_item2_comment}" hittest="false" />
            </Panel>
            <Label id="sw_item2_action" class="item-action" text="{s:sw_item2_action}" hittest="false" />
            <Label class="item-arrow" text="›" hittest="false" />
          </Button>
          <Button id="sw_item3" class="item">
            <Panel class="item-marker" hittest="false" />
            <Panel class="item-symbol" hittest="false">
              <Panel class="symbol-icon players-icon" hittest="false" />
              <Panel class="symbol-icon maps-icon" hittest="false" />
              <Panel class="symbol-icon warning-icon" hittest="false" />
              <Label id="sw_item3_glyph" class="item-glyph" text="{s:sw_item3_glyph}" hittest="false" />
            </Panel>
            <Panel class="item-body" hittest="false">
              <Label id="sw_item3_text" class="item-text" text="{s:sw_item3_text}" hittest="false" />
              <Label id="sw_item3_comment" class="item-comment" text="{s:sw_item3_comment}" hittest="false" />
            </Panel>
            <Label id="sw_item3_action" class="item-action" text="{s:sw_item3_action}" hittest="false" />
            <Label class="item-arrow" text="›" hittest="false" />
          </Button>
          <Button id="sw_item4" class="item">
            <Panel class="item-marker" hittest="false" />
            <Panel class="item-symbol" hittest="false">
              <Panel class="symbol-icon players-icon" hittest="false" />
              <Panel class="symbol-icon maps-icon" hittest="false" />
              <Panel class="symbol-icon warning-icon" hittest="false" />
              <Label id="sw_item4_glyph" class="item-glyph" text="{s:sw_item4_glyph}" hittest="false" />
            </Panel>
            <Panel class="item-body" hittest="false">
              <Label id="sw_item4_text" class="item-text" text="{s:sw_item4_text}" hittest="false" />
              <Label id="sw_item4_comment" class="item-comment" text="{s:sw_item4_comment}" hittest="false" />
            </Panel>
            <Label id="sw_item4_action" class="item-action" text="{s:sw_item4_action}" hittest="false" />
            <Label class="item-arrow" text="›" hittest="false" />
          </Button>
          </Panel>
        </Panel>
        <Panel class="menu-footer">
          <Button id="sw_home" class="nav-btn"><Label id="sw_home_text" text="{s:sw_home_text}" hittest="false" /></Button>
          <Button id="sw_back" class="nav-btn"><Label id="sw_back_text" text="{s:sw_back_text}" hittest="false" /></Button>
          <Label id="sw_footer" class="footer-text" text="{s:sw_footer}" hittest="false" />
          <Button id="sw_prev" class="page-btn"><Label text="‹" hittest="false" /></Button>
          <Label id="sw_page" class="page-text" text="{s:sw_page}" hittest="false" />
          <Button id="sw_next" class="page-btn"><Label text="›" hittest="false" /></Button>
        </Panel>
      </Panel>
    </Panel>
  </Panel>
</root>
