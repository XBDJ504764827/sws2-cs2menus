<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Sws2Cs2Menus.Contracts</AssemblyName>
    <RootNamespace>Sws2Cs2Menus.Contracts</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SwiftlyS2.CS2" Version="*" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Pins the transitive MySqlConnector pulled in by SwiftlyS2.CS2 to a version without
         GHSA-473q-m89c-ghf8, matching the plugin project. -->
    <PackageReference Include="MySqlConnector" Version="2.6.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
